{
    "height": 34,
    "spacing": 5,
    "modules-left": [
        "hyprland/workspaces"
    ],
    "modules-right": [
		"wireplumber",
		"battery",
		"cpu",
		"memory",
		"clock"
    ],
	"wireplumber": {
		"format": "[VOL {volume}%]",
		"tooltip": false
	},
	"battery": {
		"bat": "BAT1",
		"format": "[BAT {capacity}%]",
		"tooltip": false
	},
	"cpu": {
		"format": "[CPU {usage}%]",
		"tooltip": false
	},
	"memory": {
		"format": "[RAM {}%]",
		"tooltip": false
	},
	"clock": {
		"format": "{:%a %b %d %I:%M %p}",
		"tooltip": false
	}
}
