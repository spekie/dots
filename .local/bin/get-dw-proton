#!/usr/bin/env bash
tarball_url=$(curl -s "https://dawn.wine/api/v1/repos/dawn-winery/dwproton/releases/latest" | grep -oE '"browser_download_url":"[^"]*"' | cut -d\" -f4 | grep -E 'x86_64\.tar\.xz$' | head -n1)
tarball_name=$(basename "$tarball_url")

mkdir -p "$XDG_DATA_HOME/Steam/compatibilitytools.d"
wget "$tarball_url"
tar -xvf "$tarball_name" -C "$XDG_DATA_HOME/Steam/compatibilitytools.d/"
rm "$tarball_name"
